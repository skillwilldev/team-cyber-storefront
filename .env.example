VITE_API_URL=https://shop-api-kbe6.onrender.com/api

# Public address of the deployed site, no trailing slash. Used for canonical / Open Graph / sitemap.xml.
# Example: VITE_SITE_URL=https://cyber-shop.netlify.app
VITE_SITE_URL=

# Image CDN that resizes pictures and converts them to WebP (see src/lib/image.js).
# Leave the line out to use wsrv.nl; set it empty (VITE_IMAGE_PROXY=) to use the original pictures.
# VITE_IMAGE_PROXY=https://wsrv.nl
